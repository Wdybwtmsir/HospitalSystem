<Window x:Class="HospitalSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalSystem"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F6FC"
        Title="ИС «Больница» — Авторизация" Height="470" Width="430">
    <Border Background="White" CornerRadius="12" Margin="25" Padding="25" BorderBrush="#D0E1F2" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ИС «БОЛЬНИЦА»"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#1565C0"
                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Вход в информационную систему"
                       FontSize="13" Foreground="#607D8B"
                       HorizontalAlignment="Center" Margin="0,0,0,22"/>

            <TextBlock Text="Логин:" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginBox" Height="34" Padding="8,5" FontSize="14"
                     BorderBrush="#B0BEC5" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

            <TextBlock Text="Пароль:" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="34" Padding="8,5" FontSize="14"
                         BorderBrush="#B0BEC5" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorText"
                       Text="Неверный логин или пароль!"
                       Foreground="#D32F2F" FontSize="12.5" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,10"/>

            <Button Content="Войти" Height="38" FontSize="14" FontWeight="Bold"
                    Background="#1976D2" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="LoginButton_Click" Margin="0,4,0,14"/>

            <Border Background="#F8FAFC" CornerRadius="6" Padding="8">
                <TextBlock Text="Тестовый доступ:&#x0a;Регистратор: reg / 123  |  Врач: doc / 123  |  Пациент: pat / 123"
                           FontSize="11" Foreground="#546E7A" TextAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
