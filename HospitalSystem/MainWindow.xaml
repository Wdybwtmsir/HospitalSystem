<Window x:Class="HospitalSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalSystem"
        mc:Ignorable="d"
        Title="ИС «Больница» — Рабочее место"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#F0F6FC">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15,10" Margin="0,0,0,12" BorderBrush="#D0E1F2" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ИС «БОЛЬНИЦА»" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,20,0"/>
                    <TextBlock x:Name="UserInfoText" FontSize="13.5" Foreground="#37474F" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Сменить пользователя" HorizontalAlignment="Right" Padding="14,6"
                        Background="#ECEFF1" Foreground="#263238" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="LogoutButton_Click"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderBrush="#D0E1F2" BorderThickness="1" Padding="10">

            <TabItem x:Name="TabRegistrar" Header="Регистратура и расписание" FontSize="13.5" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E7EF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Регистрация нового пациента и оформление медкарты" FontSize="14" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,5">
                                    <TextBlock Text="ФИО пациента:" FontSize="12" Foreground="#455A64"/>
                                    <TextBox x:Name="PatNameBox" Width="230" Height="30" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,5">
                                    <TextBlock Text="Телефон:" FontSize="12" Foreground="#455A64"/>
                                    <TextBox x:Name="PatPhoneBox" Width="150" Height="30" Padding="6,4" Text="+7 (900) "/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,5">
                                    <TextBlock Text="Полис ОМС (16 цифр):" FontSize="12" Foreground="#455A64"/>
                                    <TextBox x:Name="PatPolicyBox" Width="170" Height="30" Padding="6,4"/>
                                </StackPanel>
                                <Button Content="Добавить пациента" Height="30" Padding="15,0" Margin="0,16,0,5"
                                        Background="#1976D2" Foreground="White" BorderThickness="0"
                                        FontWeight="Bold" Cursor="Hand" Click="AddPatient_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock DockPanel.Dock="Top" Text="База пациентов" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                            <DataGrid x:Name="PatientsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Полис ОМС" Binding="{Binding PolicyNumber}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="Расписание приемов врачей" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                            <DataGrid x:Name="AppointmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время" Binding="{Binding VisitDate, StringFormat=dd.MM HH:mm}" Width="90"/>
                                    <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="115"/>
                                    <DataGridTextColumn Header="Каб." Binding="{Binding CabinetNumber}" Width="45"/>
                                    <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabDoctor" Header="Кабинет врача" FontSize="13.5" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Text="Записанные пациенты на прием" FontSize="14" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>
                        <DataGrid x:Name="DoctorAppointmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding AppointmentId}" Width="35"/>
                                <DataGridTextColumn Header="Время" Binding="{Binding VisitDate, StringFormat=HH:mm}" Width="60"/>
                                <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="15" BorderBrush="#E0E7EF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Оформление приема и запись в медкарту" FontSize="14" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"/>
                            <TextBlock Text="Выберите пациента в таблице слева, укажите диагноз и лечение:" FontSize="12" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Диагноз:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="DiagnosisBox" Height="32" Padding="6,4" Margin="0,0,0,12"/>

                            <TextBlock Text="Назначения и рецепты:" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="PrescriptionBox" Height="90" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                            <Button Content="Сохранить в медкарту и завершить прием" Height="36"
                                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                                    FontWeight="Bold" Cursor="Hand" Click="CompleteVisit_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabPatient" Header="Личный кабинет пациента" FontSize="13.5" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Доступные талоны для записи на прием" FontSize="14" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                            <Button Content="Записаться на выбранный талон" HorizontalAlignment="Right" Padding="14,6"
                                    Background="#1976D2" Foreground="White" BorderThickness="0"
                                    FontWeight="Bold" Cursor="Hand" Click="BookSlot_Click"/>
                        </DockPanel>
                        <DataGrid x:Name="FreeSlotsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Талон №" Binding="{Binding AppointmentId}" Width="70"/>
                            </DataGrid.Columns>
                            <DataGrid.Columns>
                            </DataGrid.Columns>